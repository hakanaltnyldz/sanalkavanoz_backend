# ============================================================
# SANAL KAVANOZ BACKEND - Ortam Değişkenleri
# ============================================================
# Bu dosyayı .env olarak kopyala: cp .env.example .env
# Production'da (Render) bu değişkenleri dashboard'dan gir.
# ============================================================

# Sunucu portu (Render otomatik ayarlar, değiştirme)
PORT=3000

# Ortam: development | production
# Render'da production olarak girilmeli (render.yaml'da zaten ayarlı)
NODE_ENV=development

# ------------------------------------------------------------
# VERİTABANI - Neon PostgreSQL
# ------------------------------------------------------------
# Neon'dan al: neon.tech → Proje → Connection String (psql)
# Format: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sanalkavanoz?sslmode=require

# ------------------------------------------------------------
# JWT - Güvenlik
# ------------------------------------------------------------
# Production'da Render "Generate" butonunu kullan
# veya terminalde: openssl rand -hex 64
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Başlangıçta * bırakabilirsin (mobil uygulama için yeterli)
# Web app eklenirse gerçek domain ver: https://example.com
CORS_ORIGIN=*

# ------------------------------------------------------------
# DEMO VERİ (isteğe bağlı)
# ------------------------------------------------------------
# true yapılırsa prisma:seed iki demo kullanıcı + couple oluşturur
SEED_DEMO_USERS=false
DEMO_USER_1_EMAIL=hakan@example.com
DEMO_USER_1_PASSWORD=ChangeMe123!
DEMO_USER_1_NAME=Hakan
DEMO_USER_2_EMAIL=zeyno@example.com
DEMO_USER_2_PASSWORD=ChangeMe123!
DEMO_USER_2_NAME=Zeyno
